{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 scripts/cursor_hook.py protect_gate",
        "matcher": "Write|StrReplace|Delete",
        "failClosed": true,
        "timeout": 10
      },
      {
        "command": "python3 scripts/cursor_hook.py gate_check",
        "matcher": "Write|StrReplace|Delete",
        "failClosed": true,
        "timeout": 10
      },
      {
        "command": "python3 scripts/cursor_hook.py gate_check",
        "matcher": "Shell",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 scripts/cursor_hook.py gate_check",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
